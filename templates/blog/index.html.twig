{% extends 'base.html.twig' %}

{% block title %}Blog{% endblock %}

{% block body %}
    <div class="section-padding">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <div class="section-title text-center">
                        <h2>Nuestro Blog</h2>
                        <p>Últimas novedades y noticias</p>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-8">
                    {# BUCLE: Recorremos los posts. Si es paginación usamos .results, si es búsqueda es un array directo #}
                    {% set posts_list = posts.results is defined ? posts.results : posts %}
                    
                    {% for post in posts_list %}
                        
                        {# Incluimos el diseño de cada post individual #}
                        {{ include('partials/_post.html.twig', { 'post': post }) }}
                    
                    {% else %}
                        {# Esto sale si la base de datos está vacía #}
                        <div class="alert alert-info">
                            No hay entradas publicadas todavía.
                        </div>
                    {% endfor %}

                    {# Navegación de paginación (Solo si estamos paginando, no buscando) #}
                    {% if posts.hasToPaginate is defined and posts.hasToPaginate %}
                        <div class="text-left">
                            <ul class="pagination">
                                {% if posts.hasPreviousPage %}
                                    <li class="prev"><a href="{{ path('app_blog', {page: posts.previousPage}) }}" rel="previous"><i class="fa fw fa-long-arrow-left"></i> Previous</a></li>
                                {% else %}
                                    <li class="prev disabled"><span><i class="fa fw fa-arrow-left"></i> Previous </span></li>
                                {% endif %}

                                {% for i in 1..posts.lastPage %}
                                    {% if i == posts.currentPage %}
                                        <li class="active"><span>{{ i }}</span></li>
                                    {% else %}
                                        <li><a href="{{ path('app_blog', {page: i}) }}">{{ i }}</a></li>
                                    {% endif %}
                                {% endfor %}

                                {% if posts.hasNextPage %}
                                    <li class="next"><a href="{{ path('app_blog', {page: posts.nextPage}) }}" rel="next">Next <i class="fa fw fa-arrow-right"></i></a></li>
                                {% else %}
                                    <li class="next disabled"><span>Next <i class="fa fw fa-arrow-right"></i></span></li>
                                {% endif %}
                            </ul>
                        </div>
                    {% endif %}
                </div>
                
                <div class="col-lg-4">
                    <!-- Search Widget -->
                    <div class="card my-4">
                        <h5 class="card-header">Search</h5>
                        <div class="card-body">
                            <form class="" action='{{ path('blog_buscar') }}'>
                                <div class="input-group">
                                    <input type="text" class="form-control" placeholder="Search for..." name='searchTerm' value="{{ searchTerm is defined ? searchTerm : '' }}">
                                    <span class="input-group-append">
                                        <button class="btn btn-secondary" type="submit">Go!</button>
                                    </span>
                                </div>
                            </form>
                        </div>
                    </div>

                    <h3>Recent Posts</h3>
                    {% for recent in recents %}
                        {{ include ('partials/_recent_post.html.twig', {'recent': recent}) }}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}