{% extends 'base.html.twig' %}

{% block title %}Blog Post{% endblock %}

{% block body %}
    <div class="container">
        <div class="col-xs-12 col-sm-8 col-sm-push-2">
            {% if not post %}
                <h2>Post not found</h2>
            {% else %}
                <h1>{{post.title}}</h1>
                <img src="{{asset('images/blog/' ~ post.image) }}" class="img-responsive" alt="Post Image">

                <hr>

                <p>{{post.content}}</p>

                <hr>

                <div class="text-muted">
                    <p>Autor: {{post.postUser.name}}</p>
                    <p>Fecha: {{post.publishedAt | date('d') }} {{ post.publishedAt | date('F') }}</p>
                    <ul class="list-inline">
                        <li><a href="{{ path('post_like', {slug: post.slug}) }}">LIKE</a> <i class="fa fa-heart sr-icons"></i> {{post.numLikes}}</li>
                        <li><a class="page-scroll" href="#form">COMMENT</a> <i class="fa fa-comments sr-icons"></i> {{post.numComments}} |</li>
                    </ul>
                </div>

                {{ include ('partials/_post_comments.html.twig') }}
                
                <div class="col-xs-12 col-sm-12">
                     <h3>Comments</h3>
                    {% for comment in post.comments %}
                        {{ include('partials/_comment.html.twig', { 'comment': comment }) }}
                    {% else %}
                        <p>Be the first to comment!</p>
                    {% endfor %}
                </div>
            {% endif %}
    
        </div>
        </div>
        
        <div class="col-xs-12 col-sm-4 col-sm-pull-8">
            <h3>Recent Posts</h3>
            {% for recent in recents %}
                {{ include ('partials/_recent_post.html.twig', {'recent': recent}) }}
            {% endfor %}
        </div>
    </div>

{% endblock %}



